{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun-types"]
  },
  "include": [
    "src/**/*",
    "api/**/*",
    "scripts/**/*",
    "tests/**/*",
    "install.ts",
    "bin/**/*"
  ]
}
